{
  "ollama_host": "http://localhost:11434",
  "claude_code": {
    "command": "claude",
    "config_dir": null,
    "timeout_seconds": 180
  },
  "model_routing": {
    "default": {
      "provider": "claude_code", "model": "sonnet",
      "fallback": {"provider": "ollama", "model": "qwen2.5:7b"}
    },
    "extraction": {
      "provider": "claude_code", "model": "haiku",
      "fallback": {"provider": "ollama", "model": "qwen2.5:7b"}
    },
    "interviewer": {
      "provider": "claude_code", "model": "sonnet",
      "fallback": {"provider": "ollama", "model": "qwen2.5:7b"}
    }
  },
  "burnout": {
    "daily_minutes_threshold": 180,
    "cooldown_hours": 12
  },
  "outreach": {
    "closing_ask": "ask them to consider the candidate for this role, or to point them to the right person; do not ask for a call or meeting"
  },
  "tracker": {
    "spreadsheet_url": null,
    "stages": ["Not applied", "Applied", "Phone call", "Take Home Assessment", "Interview", "Offer"],
    "statuses": ["Asked for referral", "Got referral", "Waiting", "Didn't hear back", "Rejected"],
    "columns": {
      "company": "Company",
      "role": "Role",
      "stage": "Stage",
      "status": "Status",
      "contact": "Interviewer/HA/POC Name or Phone number (optional)",
      "job_id": "Job ID",
      "link": "Link to portal",
      "date": "Date"
    },
    "date_format": "%m/%d/%Y"
  }
}
